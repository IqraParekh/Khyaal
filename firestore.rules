rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data, userId) {
      return data.id == userId
        && data.cloudSyncConsent is bool
        && (data.email == null || (data.email is string && data.email.size() <= 256))
        && (data.displayName == null || (data.displayName is string && data.displayName.size() <= 128))
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidJournalEntry(data, userId) {
      return data.userId == userId
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.title is string && data.title.size() <= 300
        && data.rawText is string && data.rawText.size() <= 500000
        && (data.mood == null || (data.mood is string && data.mood.size() <= 64))
        && (data.hasReflection == null || data.hasReflection is bool)
        && (data.reflectionData == null || (data.reflectionData is string && data.reflectionData.size() <= 500000))
        && (data.isEncrypted == null || data.isEncrypted is bool)
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId) && isOwner(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isValidId(userId) && isOwner(userId) && isValidUserProfile(incoming(), userId);
      allow delete: if isValidId(userId) && isOwner(userId);

      match /entries/{entryId} {
        allow get: if isValidId(userId) && isValidId(entryId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(entryId) && isOwner(userId) && isValidJournalEntry(incoming(), userId);
        allow update: if isValidId(userId) && isValidId(entryId) && isOwner(userId) && isValidJournalEntry(incoming(), userId);
        allow delete: if isValidId(userId) && isValidId(entryId) && isOwner(userId);
      }
    }
  }
}
